# Copy to .env.local. Every setting is optional; see the README for all of them.

# Password for the whole app, for sharing it over a public link. Empty = open.
APP_PASSWORD=

# Model that picks clips (Ollama, local).
CLIP_PROVIDER=ollama-local
CLIP_MODEL=gemma3:12b

# Gemini, only for benchmarks in /lab.
GEMINI_API_KEY=
